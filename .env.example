# Copy to .env for local docker-compose use only.
# PLACEHOLDERS ONLY — never put a real password in this file.
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=your-generated-password-here
MONGO_INITDB_DATABASE=
# Connection string for a local instance (replace credentials):
# MONGO_URL=mongodb://root:your-generated-password-here@localhost:27017
